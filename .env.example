# ResumeLens uses platform-managed D1 and R2 bindings.
# The deterministic ATS engine requires no AI/API key.

# Supabase Auth (server-side only). Obtain these from Supabase > Connect.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical public origin. Required for magic-link and recovery callbacks.
AUTH_SITE_URL=http://localhost:3000

# Comma-separated, server-only allowlist for the private analytics dashboard.
RESUMELENS_ANALYTICS_ADMIN_EMAILS=owner@example.com
